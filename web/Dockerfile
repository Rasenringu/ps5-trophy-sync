FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG PUBLIC_ORIGIN=""
ENV PUBLIC_ORIGIN=$PUBLIC_ORIGIN
COPY package*.json .
RUN npm ci
COPY . .
RUN npm run build
USER node
EXPOSE 3000
CMD ["npm", "start"]
