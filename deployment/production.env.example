# Copy into .local/production/app.env. Use a long random hex password, not this value.
POSTGRES_PASSWORD=replace_with_at_least_32_random_hex_characters
PUBLIC_ORIGIN=https://trophy-sync.party
LOCAL_WEB_PORT=3000
# Path relative to deployment/ when used in Compose.
TUNNEL_TOKEN_FILE=../.local/production/tunnel-token
# Optional noncommercial free PlatPrices v2 key. Never use a NEXT_PUBLIC variable.
PLATPRICES_API_KEY=
PLATPRICES_REGION=us
HLTB_ENABLED=true
