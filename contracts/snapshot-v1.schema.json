{
  "$defs": {
    "Activity": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "title_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Title Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "maximum": 604800,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "clock": {
          "enum": [
            "trusted",
            "uncertain",
            "unknown"
          ],
          "title": "Clock",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "title_id",
        "title",
        "complete",
        "clock"
      ],
      "title": "Activity",
      "type": "object"
    },
    "Trophy": {
      "additionalProperties": false,
      "properties": {
        "title_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Title Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trophy_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Trophy Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "grade": {
          "enum": [
            "bronze",
            "silver",
            "gold",
            "platinum",
            "unknown"
          ],
          "title": "Grade",
          "type": "string"
        },
        "unlocked": {
          "title": "Unlocked",
          "type": "boolean"
        },
        "unlocked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unlocked At"
        }
      },
      "required": [
        "title_id",
        "title",
        "trophy_id",
        "name",
        "grade",
        "unlocked"
      ],
      "title": "Trophy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "batch_id": {
      "format": "uuid",
      "title": "Batch Id",
      "type": "string"
    },
    "source": {
      "enum": [
        "ps5_native",
        "ps4_bc"
      ],
      "title": "Source",
      "type": "string"
    },
    "mock": {
      "title": "Mock",
      "type": "boolean"
    },
    "trophies": {
      "items": {
        "$ref": "#/$defs/Trophy"
      },
      "maxItems": 2000,
      "title": "Trophies",
      "type": "array"
    },
    "activities": {
      "items": {
        "$ref": "#/$defs/Activity"
      },
      "maxItems": 2000,
      "title": "Activities",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "batch_id",
    "source",
    "mock"
  ],
  "title": "Snapshot",
  "type": "object"
}
