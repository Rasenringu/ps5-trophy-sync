{
  "$defs": {
    "Activity": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "title_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Title Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "maximum": 604800,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "clock": {
          "enum": [
            "trusted",
            "uncertain",
            "unknown"
          ],
          "title": "Clock",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "title_id",
        "title",
        "complete",
        "clock"
      ],
      "title": "Activity",
      "type": "object"
    },
    "NativeObservation": {
      "additionalProperties": false,
      "properties": {
        "raw_flags": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Raw Flags",
          "type": "integer"
        },
        "first_raw": {
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "title": "First Raw",
          "type": "string"
        },
        "second_raw": {
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "title": "Second Raw",
          "type": "string"
        }
      },
      "required": [
        "raw_flags",
        "first_raw",
        "second_raw"
      ],
      "title": "NativeObservation",
      "type": "object"
    },
    "NativeTrophy": {
      "additionalProperties": false,
      "properties": {
        "title_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Title Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trophy_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Trophy Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "grade": {
          "enum": [
            "bronze",
            "silver",
            "gold",
            "platinum",
            "unknown"
          ],
          "title": "Grade",
          "type": "string"
        },
        "unlocked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unlocked"
        },
        "unlocked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unlocked At"
        },
        "clock": {
          "enum": [
            "uncertain",
            "unknown"
          ],
          "title": "Clock",
          "type": "string"
        },
        "native_observation": {
          "$ref": "#/$defs/NativeObservation"
        }
      },
      "required": [
        "title_id",
        "title",
        "trophy_id",
        "name",
        "grade",
        "unlocked",
        "clock",
        "native_observation"
      ],
      "title": "NativeTrophy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "batch_id": {
      "format": "uuid",
      "title": "Batch Id",
      "type": "string"
    },
    "source": {
      "const": "ps5_native",
      "title": "Source",
      "type": "string"
    },
    "mock": {
      "title": "Mock",
      "type": "boolean"
    },
    "trophies": {
      "items": {
        "$ref": "#/$defs/NativeTrophy"
      },
      "maxItems": 2000,
      "title": "Trophies",
      "type": "array"
    },
    "activities": {
      "items": {
        "$ref": "#/$defs/Activity"
      },
      "maxItems": 0,
      "title": "Activities",
      "type": "array"
    },
    "consistency": {
      "const": "stable_read_not_atomic",
      "title": "Consistency",
      "type": "string"
    },
    "profile_binding": {
      "const": "foreground_user_path_scoped",
      "title": "Profile Binding",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "batch_id",
    "source",
    "mock",
    "consistency",
    "profile_binding"
  ],
  "title": "NativeSnapshot",
  "type": "object"
}
